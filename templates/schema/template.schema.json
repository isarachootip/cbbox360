{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cusbox360.io/schemas/template.v1.json",
  "title": "CusBox360 Industry Template Specification",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "apiVersion",
    "kind",
    "metadata",
    "entitlements",
    "labels",
    "customFields",
    "slaPolicies",
    "caseCategories"
  ],
  "properties": {
    "apiVersion": { "const": "cb360.io/v1" },
    "kind": { "const": "IndustryTemplate" },
    "metadata": {
      "type": "object",
      "required": ["id", "version", "industry", "name", "thaiTitle"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9_-]{2,40}$" },
        "version": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$" },
        "industry": { "type": "string", "minLength": 2 },
        "name": { "type": "string", "minLength": 2 },
        "thaiTitle": { "type": "string", "minLength": 2 },
        "description": { "type": "string" }
      }
    },
    "entitlements": {
      "type": "object",
      "required": ["modules"],
      "properties": {
        "modules": { "type": "array", "items": { "type": "string" } },
        "connectors": { "type": "array", "items": { "type": "string" } },
        "flags": { "type": "array", "items": { "type": "string" } }
      }
    },
    "brandingDefaults": {
      "type": "object",
      "properties": {
        "primaryColor": { "type": "string", "pattern": "^#[0-9A-Fa-f]{6}$" },
        "accentColor": { "type": "string", "pattern": "^#[0-9A-Fa-f]{6}$" },
        "logoUrl": { "type": "string" }
      }
    },
    "labels": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": { "type": "string" }
      }
    },
    "roles": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["key", "name", "permissions"],
        "properties": {
          "key": { "type": "string" },
          "name": { "type": "string" },
          "permissions": { "type": "array", "items": { "type": "string" } }
        }
      }
    },
    "customFields": {
      "type": "object",
      "properties": {
        "contact": { "type": "array" },
        "case": { "type": "array" }
      }
    },
    "slaPolicies": { "type": "array", "minItems": 1 },
    "caseCategories": { "type": "array", "minItems": 1 },
    "workflows": { "type": "array" },
    "omnichannelPresets": { "type": "object" }
  }
}
