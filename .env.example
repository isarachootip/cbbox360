# Environment Variables for CB360

# ─── PostgreSQL ───────────────────────────────────
# ใส่ใน Coolify → Environment Variables → DATABASE_URL
DATABASE_URL=postgresql://username:password@host:5432/cb360

# ─── LINE Messaging API ───────────────────────────
LINE_CHANNEL_ACCESS_TOKEN=your_line_channel_access_token_here

# ─── Server ───────────────────────────────────────
PORT=3000

# ─── Google Maps & Places API ─────────────────────
# ใส่ Google Maps JavaScript API Key (เปิดใช้งาน Places API และ Geocoding API)
VITE_GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here

# ─── Google Gemini AI (Smart Auto-Reply & Fallback) ──
# ใช้สำหรับ AI Smart Assistant ในการตอบแชท LINE เมื่อไม่ตรงคีย์เวิร์ด หรือนอกเวลาทำการ
GEMINI_API_KEY=your_gemini_api_key_here

# ─── Authentication & Security (Phase 1A) ─────────
# คีย์สำหรับเข้ารหัส TOTP Secret ในฐานข้อมูล (AES-256-GCM แนะนำความยาวอย่างน้อย 32 ตัวอักษร)
TOTP_ENCRYPTION_KEY=replace_with_32_byte_random_secret_key_in_production
# อายุ Session Cookie (ชั่วโมง)
SESSION_TTL_HOURS=8

