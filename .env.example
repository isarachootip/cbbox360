# Environment Variables for CB360

# ─── PostgreSQL ───────────────────────────────────
# ใส่ใน Coolify → Environment Variables → DATABASE_URL
DATABASE_URL=postgresql://username:password@host:5432/cb360

# ─── LINE Messaging API ───────────────────────────
LINE_CHANNEL_ACCESS_TOKEN=your_line_channel_access_token_here

# ─── Server ───────────────────────────────────────
PORT=3000

# ─── Google Maps & Places API ─────────────────────
# ใส่ Google Maps JavaScript API Key (เปิดใช้งาน Places API และ Geocoding API)
VITE_GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here
